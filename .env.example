YOGIYATRA_API_BASE_URL=http://localhost:8002/api
YOGIYATRA_IMAGE_BASE_URL=http://localhost:8002/storage
YOGIFY_WORKSHOP_IMAGE_BASE_URL=http://localhost:8003/storage

